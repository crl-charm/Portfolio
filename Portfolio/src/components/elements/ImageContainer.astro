---
// assets 
import { Image } from "astro:assets";
import barCode from "../../assets/ui/barcode.svg";

const {src, alt} = Astro.props;
---
<div class="flex flex-col items-end gap-2 w-full">
    <Image src={barCode} alt="Bar Code" loading="eager" class="w-auto max-w-[180px] h-[20px] sm:h-[24px] self-start"/>
    <div class="p-3 sm:p-4 border-2 border-base-900 w-full max-w-[520px] mx-auto overflow-hidden bg-base-100 shadow-[0_0_0_1px_rgba(0,0,0,0.12)]">
        <div class="aspect-[4/5] w-full overflow-hidden">
            <Image 
                src={src} 
                alt={alt} 
                loading="eager" 
                class="w-full h-full object-cover object-center grayscale-75 rounded-none" 
                widths={[300, 450, 700, 1100, src.width]}
                sizes={`(max-width: 320px) 300px, (max-width: 480px) 450px, (max-width: 768px) 700px, (max-width: 1200px) 1100px, ${src.width}px`}
            />
        </div>
    </div>
</div>
