---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import ResumeDropdown from "../../elements/ResumeDropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const experience = [
    { 
        title: "Student Developer",
        place: "Self-Driven / Academic Projects",
        period: "2024 - Present",
        text: "Worked on academic and personal software projects involving backend development, frontend development, system architecture, database management, and web application development."
    },
    { 
        title: "Backend & Full-Stack Developer",
        place: "Personal Projects",
        period: "2025 - Present",
        text: "Built and designed systems for business operations, inventory tracking, sales monitoring, and user management with a focus on functionality and clean code."
    },
    { 
        title: "Web Application Developer",
        place: "Project-Based Work",
        period: "2024 - 2025",
        text: "Developed responsive web applications using Flask, React, Vite, and MySQL, with emphasis on usability, business workflow support, and maintainable code."
    }
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Experience</Heading>
    <div class="flex flex-col gap-4">  
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                experience.map((i) => (
                    <ResumeDropdown title={i.title} place={i.place} period={i.period} text={i.text} />
                ))
            }
        </Container>
        <ContainerBottom />
    </div>

</Container>
