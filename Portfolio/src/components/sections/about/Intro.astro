---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import peter from "../../../assets/images/pic1.jpg";
---

<Container variant={'xl'}>
    <Heading tagName="h1" tagSize="h1" class="text-center">Meet Carl</Heading>
    <div class="flex md:flex-row flex-col gap-16 md:items-center">
        <div class="flex-1 flex flex-col gap-7">
            <Text variant={'xl'} class="text-base-900">I’m a developer who enjoys turning ideas into systems that work smoothly, scale cleanly, and solve real problems.</Text>
            <Text variant={'sm'} class="text-base-900">I’m a 4th year BSIT student focused on backend development, frontend development, system architecture, and database management. I build practical digital solutions for business and campus needs, balancing clean code, user experience, and reliable functionality.</Text>
        </div>
        <div class="flex-1 md:h-[500px] w-full">
            <ImageContainer src={peter} alt="Carl Nathaniel Oñang"/>
        </div>
    </div>
</Container>