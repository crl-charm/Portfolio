---
// components
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
import Link from "../../elements/Link.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import peter2 from "../../../assets/images/peter2.jpg";
---

<Container variant={'xl'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">About</Heading>
    <div class="flex lg:flex-row lg:gap-16 gap-10 flex-col">
        <div class="flex flex-col items-start gap-6 lg:pt-6 text-base-900 lg:flex-1">
            <Text variant={'xl'}>I build software that is practical, scalable, and meant to be used by real people every day.</Text>
            <Text variant={'sm'}>My focus is on backend systems, web applications, and database-driven solutions that help businesses manage operations more efficiently. I enjoy solving technical problems and turning business needs into clean, working digital products.</Text>
            <Text variant={'sm'}>Beyond coding, I’m interested in system architecture, automation, and creating user-friendly interfaces that make software easier to use and more valuable to the people relying on it.</Text>
            <Link variant={'button'} href="/about">More about me</Link>
        </div>
        <div class="w-full lg:h-[500px] h-auto lg:flex-1">
            <ImageContainer src={peter2} alt="Carl Nathaniel Oñang" />
        </div>
    </div>
</Container>