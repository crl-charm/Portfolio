---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
import peter from "../../../assets/images/pic1.jpg";
---

<Container variant={"xl"} class="flex flex-col gap-6 md:gap-8 min-h-screen py-4 md:py-6">
    <Text variant={'xl'} class="text-base-900 lg:max-w-[32rem] md:max-w-[28rem] w-full leading-tight">You bring the vision, and I’ll transform it into a digital experience that works and stands out.</Text>
    <Container class="flex md:flex-row flex-col items-center md:items-end gap-6 md:gap-8">
        <Container class="md:flex-1 flex flex-col items-start gap-4 md:pb-2">
            <Link variant={'button'} href="/contact">Available for work</Link>
            <Heading tagName="h1" tagSize="h1" class="leading-none">Carl Nathaniel Oñang</Heading>
        </Container>
        <Container class="w-full md:w-auto md:flex-[1.1] max-w-[520px] md:max-w-none">
            <div class="w-full max-w-[420px] md:max-w-[500px] mx-auto md:mx-0 md:h-[420px] h-[300px]">
                <ImageContainer src={peter} alt="Carl Nathaniel Oñang" />
            </div>
        </Container>
    </Container>
</Container>

