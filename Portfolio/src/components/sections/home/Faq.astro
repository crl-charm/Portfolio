---
// components
import Container from "../../elements/Container.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";
import Heading from "../../elements/Heading.astro";
import Dropdown from "../../elements/Dropdown.astro";

// content
const faq = [
    { 
        title: "What kind of projects do you enjoy building?",
        text: "I enjoy building business systems, web applications, and tools that improve operations, automate workflows, and make processes easier to manage."
    },
    { 
        title: "What technologies do you work with?",
        text: "I work with technologies like Flask, React, Vite, Node.js, JavaScript, HTML, CSS, and MySQL, with a focus on building reliable and user-friendly solutions."
    },
    { 
        title: "What is your development approach?",
        text: "I focus on understanding the problem first, then designing a clean structure, implementing the system, and refining the experience based on user needs and functionality."
    },
    { 
        title: "Do you work with clients remotely?",
        text: "Yes. I’m comfortable collaborating remotely, discussing requirements, planning features, and delivering functional software that fits the project goals."
    },
    { 
        title: "Can you build both frontend and backend systems?",
        text: "Yes. I can work across the full stack, from user interfaces and logic to database structure and business workflows."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">FAQ</Heading>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                faq.map((q, index) => (
                    <Dropdown title=`${index + 1}. ${q.title}`  text={q.text} />
                ))
            }
        </Container>
        <ContainerBottom />        
    </div>
    
</Container>