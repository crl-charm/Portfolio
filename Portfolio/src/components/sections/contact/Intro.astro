---
// components
import Heading from "../../elements/Heading.astro";
import Container from "../../elements/Container.astro";
import Text from "../../elements/Text.astro";
---

<Container variant={'xl'} class="text-center text-base-900 flex flex-col items-center">
    <Heading tagName="h1" tagSize="h1">Contact</Heading>
    <div class="max-w-3xl flex flex-col gap-4">
        <Text variant={'xl'}>Let’s build something useful and memorable together.</Text>
        <Text variant={'sm'}>I’m open to collaborations, personal projects, and software work that needs thoughtful backend logic, clean interfaces, and practical solutions.</Text>
        <Text variant={'sm'}>Available for internships, freelance work, and project-based development opportunities.</Text>
    </div>
</Container>